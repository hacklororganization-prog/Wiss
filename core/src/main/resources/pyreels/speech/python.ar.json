{
  "language": "python",
  "locale": "ar",
  "description": "Arabic reading rules for Python code. Patterns run first (in order), then operators, keywords, builtins, letters and numbers. {1},{2}.. are regex groups; {n:1} reads group 1 as a number.",
  "patterns": [
    { "regex": "for\\s+(\\w+)\\s+in\\s+range\\(\\s*(\\d+)\\s*\\)\\s*:?", "say": "لكل {id:1} في المدى من صفر إلى {n:2}" },
    { "regex": "for\\s+(\\w+)\\s+in\\s+range\\(\\s*(\\d+)\\s*,\\s*(\\d+)\\s*\\)\\s*:?", "say": "لكل {id:1} في المدى من {n:2} إلى {n:3}" },
    { "regex": "for\\s+(\\w+)\\s+in\\s+(\\w+)\\s*:?", "say": "لكل {id:1} في {id:2}" },
    { "regex": "print\\(\\s*\\)", "say": "دالة الطباعة بلا شيء" },
    { "regex": "print\\(", "say": "دالة الطباعة لـ " },
    { "regex": "input\\(", "say": "دالة الإدخال لـ " },
    { "regex": "def\\s+(\\w+)\\s*\\(", "say": "عرّف الدالة {id:1} التي تأخذ " },
    { "regex": "while\\s+", "say": "طالما " },
    { "regex": "elif\\s+", "say": "وإلا إذا " },
    { "regex": "else\\s*:", "say": "وإلا: " },
    { "regex": "if\\s+", "say": "إذا " },
    { "regex": "\"([^\"]*)\"", "say": "النص «{1}»" },
    { "regex": "'([^']*)'", "say": "النص «{1}»" }
  ],
  "operators": {
    "==": "يطابق", "!=": "لا يساوي", "<=": "أصغر من أو يساوي", ">=": "أكبر من أو يساوي",
    "+=": "يزيد بمقدار", "-=": "ينقص بمقدار", "*=": "يُضرب في", "/=": "يُقسم على", "**": "أُس", "//": "قسمة صحيحة على",
    "->": "ترجع", "=": "يساوي", "+": "زائد", "-": "ناقص", "*": "ضرب", "/": "قسمة", "%": "باقي القسمة على",
    "<": "أصغر من", ">": "أكبر من", ":": "نقطتان", "(": "", ")": "", "[": "قائمة ", "]": "", "{": "قاموس ", "}": "",
    ",": "و", ".": " نقطة ", "#": "تعليق: "
  },
  "keywords": {
    "True": "صح", "False": "خطأ", "None": "لا شيء", "and": "و", "or": "أو", "not": "ليس", "in": "في",
    "return": "أرجِع", "import": "استورد", "from": "من", "class": "صنف", "is": "هو", "pass": "تجاوز",
    "break": "اكسر الحلقة", "continue": "تابع", "lambda": "دالة صغيرة", "try": "حاول", "except": "إلا عند الخطأ",
    "with": "مع", "as": "باسم", "def": "عرّف", "range": "المدى", "len": "طول", "int": "عدد صحيح", "str": "نص",
    "float": "عدد عشري", "list": "قائمة", "dict": "قاموس", "type": "نوع", "self": "سِلف"
  },
  "letters": {
    "a": "إيه", "b": "بي", "c": "سي", "d": "دي", "e": "إي", "f": "إف", "g": "جي", "h": "إتش", "i": "آي", "j": "جاي",
    "k": "كاي", "l": "إل", "m": "إم", "n": "إن", "o": "أو", "p": "بي", "q": "كيو", "r": "آر", "s": "إس", "t": "تي",
    "u": "يو", "v": "في", "w": "دبليو", "x": "إكس", "y": "واي", "z": "زد"
  },
  "indent": "مسافة بادئة",
  "newline": "، ثم "
}
