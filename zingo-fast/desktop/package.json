{
  "name": "zingo-fast",
  "productName": "Voltra",
  "version": "1.2.0",
  "description": "Voltra - electronic circuit design and simulation",
  "author": "Voltra <ahmedhamdi0s10@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-app": "node scripts/prepare-app.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win nsis --x64",
    "dist:dir": "npm run prepare-app && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.zingofast.app",
    "productName": "Voltra",
    "copyright": "Copyright © 2026 Voltra",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/index.html",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "voltra",
        "name": "Voltra Project",
        "description": "Voltra circuit project",
        "role": "Editor",
        "icon": "build/file.ico"
      },
      {
        "ext": "zingo",
        "name": "Voltra Project",
        "description": "Voltra circuit project",
        "role": "Editor",
        "icon": "build/file.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Voltra-Setup-${version}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Voltra",
      "uninstallDisplayName": "Voltra",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hacklororganization-prog/Wiss.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  }
}
