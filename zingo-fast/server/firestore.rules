rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The apps read the server address; only the owner account (used by app.js) can change it.
    match /zingo/server {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "PUT-YOUR-OWNER-EMAIL-HERE";
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
